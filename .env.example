# این فایل فقط نمونه‌ست. مقدارهای واقعی رو توی Railway → Variables وارد کن، نه اینجا.

# --- الزامی ---
TELEGRAM_BOT_TOKEN=123456789:AAAA...
ADMIN_TELEGRAM_ID=123456789
IG_USERNAME=your_page_username
IG_PASSWORD=your_page_password

# --- قابلیت دایرکت ---
DM_SENDER_USERNAME=your_personal_username
DM_POLL_MINUTES=5

# --- دیتابیس (برای Render رایگان الزامی) ---
# آدرس Session pooler از Supabase. خالی = SQLite محلی توی DATA_DIR
DATABASE_URL=

# --- اختیاری ---
# کلید راه‌اندازی Google Authenticator (اگه نذاری، ربات کد رو توی تلگرام ازت می‌پرسه)
IG_TOTP_SECRET=
# پراکسی برای اینستاگرام/یوتیوب: http://user:pass@host:port
IG_PROXY=
YT_PROXY=
# محتوای کامل فایل cookies.txt یوتیوب (اگه یوتیوب سرور رو بلاک کرد)
YT_COOKIES=

MAX_ITEMS_PER_SOURCE=3
MAX_VIDEO_SECONDS=180
PUBLISH_GAP_SECONDS=180
DAILY_PUBLISH_LIMIT=15
DATA_DIR=/data
